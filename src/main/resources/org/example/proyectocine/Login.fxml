<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefWidth="760.0" prefHeight="460.0" styleClass="raiz" stylesheets="@estilos.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectocine.viewController.LoginViewController">

    <!-- Lado izquierdo: marca del cine -->
    <VBox alignment="CENTER_LEFT" spacing="12.0" prefWidth="330.0" styleClass="login-marca">
        <padding>
            <Insets top="40.0" right="35.0" bottom="40.0" left="35.0"/>
        </padding>
        <Label text="CinemaUQ" styleClass="login-logo"/>
        <Label text="Compra tus entradas, elige tus asientos y acumula puntos en cada visita."
               styleClass="login-lema" wrapText="true"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="Universidad del Quindío · Programación II" styleClass="login-pie" wrapText="true"/>
    </VBox>

    <!-- Lado derecho: formulario -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="30.0" right="45.0" bottom="30.0" left="45.0"/>
        </padding>

        <VBox spacing="12.0" styleClass="tarjeta" maxWidth="340.0">
            <Label text="Iniciar sesión" styleClass="titulo"/>
            <Label text="Ingresa con tu correo y contraseña." wrapText="true"/>

            <Label text="Correo"/>
            <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" onAction="#onIngresar"/>

            <Label text="Contraseña"/>
            <PasswordField fx:id="txtClave" promptText="Contraseña" onAction="#onIngresar"/>

            <Label fx:id="lblMensaje" wrapText="true" styleClass="mensaje-error"/>

            <Button text="Ingresar" defaultButton="true" onAction="#onIngresar"
                    styleClass="boton-principal" maxWidth="Infinity"/>

            <HBox alignment="CENTER" spacing="4.0">
                <Label text="¿No tienes cuenta?"/>
                <Hyperlink text="Regístrate" onAction="#onRegistrarse" styleClass="enlace"/>
            </HBox>
        </VBox>
    </VBox>
</HBox>
