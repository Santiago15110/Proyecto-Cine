<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="raiz" stylesheets="@estilos.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="org.example.proyectocine.viewController.PaginaInicioViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
    <Button onAction="#onHelloButtonClick" text="Hello!" />
    <Button onAction="#onRegistroClick" text="Registro de usuarios" />
    <Button onAction="#onTarjetaClick" text="Mi tarjeta" />

    <!-- Nuevo botón añadido para conectar con el módulo de reportes -->
    <Button onAction="#onReportesClick" text="Panel de Reportes" />
</VBox>
