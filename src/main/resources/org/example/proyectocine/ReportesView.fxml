<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" prefWidth="860.0" prefHeight="620.0" styleClass="raiz" stylesheets="@estilos.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectocine.viewController.ReportesViewController">
    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <!-- Título principal igual que en las demás vistas -->
    <Label text="Reportes operativos" styleClass="titulo"/>

    <!-- Tarjeta superior: Filtros de fecha -->
    <VBox spacing="10.0" styleClass="tarjeta">
        <Label text="Periodo de consulta" styleClass="subtitulo"/>
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <Label text="Fecha inicio:"/>
            <DatePicker fx:id="dpFechaInicio" promptText="Seleccionar inicio" prefWidth="160.0"/>

            <Label text="Fecha fin:"/>
            <DatePicker fx:id="dpFechaFin" promptText="Seleccionar fin" prefWidth="160.0"/>

            <Label text="(No aplica para ocupación de salas)" styleClass="dato-pequeno"/>
        </HBox>
    </VBox>

    <!-- Contenedor dividido: Izquierda (7 reportes) y Derecha (3 formatos de salida) -->
    <HBox spacing="15.0" VBox.vgrow="ALWAYS">

        <!-- PANEL IZQUIERDO: Selección del tipo de reporte -->
        <VBox spacing="10.0" prefWidth="250.0" styleClass="tarjeta">
            <Label text="1. Tipo de reporte" styleClass="subtitulo"/>
            <ListView fx:id="lvTiposReporte" VBox.vgrow="ALWAYS"/>
            <Button text="Generar reporte" maxWidth="Infinity" defaultButton="true"
                    onAction="#onGenerarReporte" styleClass="boton-principal"/>
        </VBox>

        <!-- PANEL DERECHO: Opciones de visualización y exportación -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="tarjeta">
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="2. Formato:" styleClass="subtitulo"/>

                <!-- Opciones de cómo quiere ver el reporte -->
                <RadioButton fx:id="rbTexto" text="Texto / Tabla" selected="true" onAction="#onCambiarVista">
                    <toggleGroup>
                        <ToggleGroup fx:id="tgFormato"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="rbVisual" text="Gráfico visual" toggleGroup="$tgFormato" onAction="#onCambiarVista"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Selector de tipo de gráfico (se activa cuando se elige Gráfico visual) -->
                <ComboBox fx:id="cmbTipoGrafico" promptText="Tipo de gráfico" prefWidth="145.0"
                          disable="true" onAction="#onCambiarTipoGrafico"/>
            </HBox>

            <!-- Área central dinámica donde se muestra el texto o el gráfico -->
            <StackPane VBox.vgrow="ALWAYS" prefHeight="280.0">
                <TextArea fx:id="txtResultadoTexto" editable="false" wrapText="false"
                          style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 12px;"/>
                <StackPane fx:id="panelGrafico" visible="false"/>
            </StackPane>

            <!-- Botones de exportación directa -->
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Label fx:id="lblMensaje" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Exportar a TXT" onAction="#onExportarTxt"/>
                <Button text="Exportar a PDF" onAction="#onExportarPdf" styleClass="boton-principal"/>
            </HBox>
        </VBox>

    </HBox>

    <!-- Botón inferior de navegación igual que en Registro y Tarjeta -->
    <HBox>
        <Button text="Volver" cancelButton="true" onAction="#onVolver"/>
    </HBox>
</VBox>
