<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" prefWidth="760.0" styleClass="raiz" stylesheets="@estilos.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectocine.viewController.TarjetaViewController">
    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <Label text="Mi tarjeta virtual" styleClass="titulo"/>

    <!-- Temporal: mientras no exista el login, se busca el cliente por cédula -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Cédula del cliente:"/>
        <TextField fx:id="txtCedula" promptText="Número de cédula" prefWidth="200.0" onAction="#onConsultar"/>
        <Button text="Consultar" onAction="#onConsultar"/>
        <Label fx:id="lblBusqueda" styleClass="mensaje-error"/>
    </HBox>

    <VBox fx:id="contenido" spacing="15.0" disable="true">

        <!-- Tarjeta y puntos -->
        <HBox spacing="15.0">
            <VBox spacing="6.0" styleClass="tarjeta-virtual" HBox.hgrow="ALWAYS">
                <Label text="TARJETA VIRTUAL CINE" styleClass="dato-pequeno"/>
                <Label fx:id="lblNumero" text="N° ----" styleClass="dato-mediano"/>
                <Label fx:id="lblTitular" text="Titular" styleClass="dato-pequeno"/>
                <Label text="Saldo disponible" styleClass="dato-pequeno">
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </Label>
                <Label fx:id="lblSaldo" text="\$ 0" styleClass="dato-grande"/>
            </VBox>

            <VBox spacing="6.0" styleClass="tarjeta" minWidth="230.0">
                <Label text="Puntos acumulados" styleClass="subtitulo"/>
                <Label fx:id="lblPuntos" text="0" styleClass="dato-grande, texto-acento"/>
                <Label fx:id="lblVencimiento" text="Vencen el --/--/----"/>
            </VBox>
        </HBox>

        <!-- Recarga -->
        <VBox spacing="10.0" styleClass="tarjeta">
            <Label text="Recargar saldo" styleClass="subtitulo"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="txtMonto" promptText="Monto a recargar" prefWidth="200.0" onAction="#onRecargar"/>
                <Button text="Recargar" onAction="#onRecargar" styleClass="boton-principal"/>
            </HBox>
            <Label fx:id="lblMensaje" wrapText="true"/>
        </VBox>

        <!-- Movimientos -->
        <Label text="Movimientos" styleClass="subtitulo"/>
        <TableView fx:id="tblMovimientos" prefHeight="200.0">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="95.0"/>
                <TableColumn fx:id="colHora" text="Hora" prefWidth="80.0"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100.0"/>
                <TableColumn fx:id="colMonto" text="Monto" prefWidth="100.0"/>
                <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="100.0"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="230.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Todavía no hay movimientos"/>
            </placeholder>
        </TableView>
    </VBox>

    <HBox>
        <Button text="Volver" cancelButton="true" onAction="#onVolver"/>
    </HBox>
</VBox>
