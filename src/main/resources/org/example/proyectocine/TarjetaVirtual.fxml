<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" prefWidth="760.0" styleClass="raiz" stylesheets="@estilos.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectocine.viewController.TarjetaViewController">
    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <Label text="Mi tarjeta virtual" styleClass="titulo"/>

    <!-- Se muestra si nadie ha iniciado sesión como cliente -->
    <Label fx:id="lblSinSesion" text="Inicia sesión como cliente para ver tu tarjeta."
           styleClass="mensaje-error" wrapText="true"/>

    <VBox fx:id="contenido" spacing="15.0">

        <!-- Tarjeta y puntos -->
        <HBox spacing="15.0">
            <VBox spacing="6.0" styleClass="tarjeta-virtual" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="TARJETA VIRTUAL CINE" styleClass="dato-pequeno"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblEstado" text="ACTIVA" styleClass="estado-activa"/>
                </HBox>
                <Label fx:id="lblNumero" text="N° ----" styleClass="dato-mediano"/>
                <Label fx:id="lblTitular" text="Titular" styleClass="dato-pequeno"/>
                <Label text="Saldo disponible" styleClass="dato-pequeno">
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </Label>
                <Label fx:id="lblSaldo" text="\$ 0" styleClass="dato-grande"/>
            </VBox>

            <VBox spacing="6.0" styleClass="tarjeta" minWidth="230.0">
                <Label text="Puntos CinemaUQ" styleClass="subtitulo"/>
                <Label fx:id="lblPuntos" text="0" styleClass="dato-grande, texto-acento"/>
                <Label fx:id="lblVencimiento" text="Sin puntos por vencer" wrapText="true"/>
            </VBox>
        </HBox>

        <Label fx:id="lblAviso" wrapText="true"
               text="¿Necesitas más saldo? Las recargas las realiza el administrador del cine."/>

        <!-- Historiales -->
        <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="240.0">
            <Tab text="Movimientos">
                <TableView fx:id="tblMovimientos">
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="95.0"/>
                        <TableColumn fx:id="colHora" text="Hora" prefWidth="80.0"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100.0"/>
                        <TableColumn fx:id="colMonto" text="Monto" prefWidth="100.0"/>
                        <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="100.0"/>
                        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="230.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Todavía no hay movimientos"/>
                    </placeholder>
                </TableView>
            </Tab>
            <Tab text="Mis puntos">
                <TableView fx:id="tblPuntos">
                    <columns>
                        <TableColumn fx:id="colPtsObtenidos" text="Puntos" prefWidth="80.0"/>
                        <TableColumn fx:id="colPtsFecha" text="Fecha de obtención" prefWidth="140.0"/>
                        <TableColumn fx:id="colPtsVence" text="Fecha de vencimiento" prefWidth="140.0"/>
                        <TableColumn fx:id="colPtsDisponibles" text="Disponibles" prefWidth="100.0"/>
                        <TableColumn fx:id="colPtsEstado" text="Estado" prefWidth="100.0"/>
                        <TableColumn fx:id="colPtsOrigen" text="Origen" prefWidth="140.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Todavía no tienes puntos"/>
                    </placeholder>
                </TableView>
            </Tab>
        </TabPane>
    </VBox>

    <HBox>
        <Button text="Volver" cancelButton="true" onAction="#onVolver"/>
    </HBox>
</VBox>
