<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" prefWidth="1000.0" prefHeight="600.0" styleClass="raiz" stylesheets="@estilos.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectocine.viewController.MisComprasViewController">
    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <Label text="Mis compras" styleClass="titulo"/>

    <Label fx:id="lblSinSesion" text="Inicia sesión como cliente para ver tus compras."
           styleClass="mensaje-error" wrapText="true"/>

    <HBox fx:id="contenido" spacing="15.0" VBox.vgrow="ALWAYS">

        <!-- Historial -->
        <TableView fx:id="tblCompras" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="100.0"/>
                <TableColumn fx:id="colFecha" text="Fecha de compra" prefWidth="130.0"/>
                <TableColumn fx:id="colPelicula" text="Película" prefWidth="170.0"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="100.0"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Todavía no tienes compras"/>
            </placeholder>
        </TableView>

        <!-- Detalle de la compra elegida -->
        <VBox styleClass="tarjeta" prefWidth="320.0" minWidth="320.0" maxWidth="320.0">
            <Label fx:id="lblSinSeleccion" text="Selecciona una compra para ver su detalle"
                   styleClass="texto-secundario" wrapText="true"/>

            <VBox fx:id="panelDetalle" spacing="10.0">
                <Label fx:id="lblDetCodigo" styleClass="subtitulo"/>
                <Label fx:id="lblDetEstado" styleClass="texto-secundario"/>

                <Separator/>

                <Label text="PELÍCULA" styleClass="etiqueta-seccion"/>
                <Label fx:id="lblDetPelicula" wrapText="true"/>
                <Label text="FUNCIÓN" styleClass="etiqueta-seccion"/>
                <Label fx:id="lblDetFuncion" wrapText="true"/>
                <Label text="ASIENTOS" styleClass="etiqueta-seccion"/>
                <Label fx:id="lblDetAsientos" wrapText="true"/>
                <Label text="CONFITERÍA" styleClass="etiqueta-seccion"/>
                <Label fx:id="lblDetProductos" wrapText="true"/>
                <Label text="PAGO" styleClass="etiqueta-seccion"/>
                <Label fx:id="lblDetPago" wrapText="true"/>

                <Separator/>

                <Label fx:id="lblReembolso" wrapText="true" styleClass="texto-acento"/>
                <Button fx:id="btnCancelar" text="Cancelar compra" styleClass="boton-principal"
                        maxWidth="Infinity" onAction="#onCancelarCompra"/>
                <Label text="Más de 24 h antes: 100 %. Entre 24 h y 2 h: 80 %. Menos de 2 h: no se puede cancelar."
                       styleClass="texto-secundario" wrapText="true"/>
                <Label fx:id="lblMensaje" wrapText="true"/>
            </VBox>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT">
        <Button text="Volver" cancelButton="true" onAction="#onVolver"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblResumen" styleClass="texto-secundario"/>
    </HBox>
</VBox>
