<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" prefWidth="880.0" styleClass="raiz" stylesheets="@estilos.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectocine.viewController.AdminComprasViewController">
    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label text="Historial general de compras" styleClass="titulo"/>
            <Label text="Consulta todas las transacciones realizadas por los clientes en el cine"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="← Volver al panel" onAction="#onVolver"/>
    </HBox>

    <HBox spacing="15.0">
        <VBox spacing="4.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="Total compras" styleClass="subtitulo"/>
            <Label fx:id="lblTotalCompras" text="0" styleClass="dato-grande, texto-acento"/>
            <Label text="Registradas en el sistema"/>
        </VBox>
        <VBox spacing="4.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="Pagadas" styleClass="subtitulo"/>
            <Label fx:id="lblComprasPagadas" text="0" styleClass="dato-grande, texto-acento"/>
            <Label text="Confirmadas con saldo o puntos"/>
        </VBox>
        <VBox spacing="4.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="Canceladas" styleClass="subtitulo"/>
            <Label fx:id="lblComprasCanceladas" text="0" styleClass="dato-grande, texto-acento"/>
            <Label text="Anuladas por cliente o función"/>
        </VBox>
    </HBox>

    <VBox spacing="10.0" styleClass="tarjeta">
        <Label text="Detalle de transacciones" styleClass="subtitulo"/>
        <TableView fx:id="tblCompras" prefHeight="250.0">
            <columns>
                <TableColumn fx:id="colId" text="ID Compra" prefWidth="115.0"/>
                <TableColumn fx:id="colCliente" text="Cliente" prefWidth="215.0"/>
                <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="265.0"/>
                <TableColumn fx:id="colPago" text="Total / Puntos" prefWidth="115.0"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
            </columns>
            <placeholder>
                <Label text="No hay compras registradas"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>