<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" prefWidth="980.0" styleClass="raiz" stylesheets="@estilos.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectocine.viewController.ConfiteriaPagoViewController">
    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <Label text="Confitería y pago" styleClass="titulo"/>

    <HBox spacing="18.0">
        <!-- Izquierda: confitería -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <VBox spacing="10.0" styleClass="tarjeta">
                <Label text="Agrega productos o combos (opcional)" styleClass="subtitulo"/>
                <TableView fx:id="tblConfiteria" prefHeight="190.0">
                    <columns>
                        <TableColumn fx:id="colProducto" text="Producto" prefWidth="200.0"/>
                        <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90.0"/>
                        <TableColumn fx:id="colPuntosProducto" text="En puntos" prefWidth="80.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Cantidad:"/>
                    <Spinner fx:id="spnCantidad" prefWidth="80.0" editable="true"/>
                    <Button text="Agregar" onAction="#onAgregarProducto"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="tarjeta">
                <Label text="Tu pedido de confitería" styleClass="subtitulo"/>
                <TableView fx:id="tblCarrito" prefHeight="130.0">
                    <columns>
                        <TableColumn fx:id="colCarritoProducto" text="Producto" prefWidth="200.0"/>
                        <TableColumn fx:id="colCarritoCantidad" text="Cantidad" prefWidth="80.0"/>
                        <TableColumn fx:id="colCarritoSubtotal" text="Subtotal" prefWidth="90.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Sin productos"/>
                    </placeholder>
                </TableView>
                <HBox>
                    <Button text="Quitar seleccionado" onAction="#onQuitarProducto"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Derecha: resumen y pago -->
        <VBox spacing="10.0" styleClass="tarjeta" prefWidth="360.0" minWidth="340.0">
            <Label text="Resumen de tu compra" styleClass="subtitulo"/>
            <Label fx:id="lblPelicula" text="Película" styleClass="dato-mediano" wrapText="true"/>
            <Label fx:id="lblFuncion" text="Función" wrapText="true"/>
            <Label fx:id="lblAsientos" text="Asientos" wrapText="true"/>
            <Separator/>

            <HBox>
                <Label fx:id="lblEntradasTexto" text="Entradas"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblEntradas" text="\$ 0"/>
            </HBox>
            <HBox>
                <Label text="Confitería"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConfiteria" text="\$ 0"/>
            </HBox>

            <Label text="Promoción"/>
            <ComboBox fx:id="cmbPromocion" maxWidth="Infinity"/>

            <Separator/>
            <HBox alignment="CENTER_LEFT">
                <Label text="Total" styleClass="subtitulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" text="\$ 0" styleClass="dato-grande, texto-acento"/>
            </HBox>
            <HBox>
                <Label text="o con puntos"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotalPuntos" text="0 pts"/>
            </HBox>
            <Label fx:id="lblDisponible" text="Saldo: \$ 0 · Puntos: 0" wrapText="true"/>

            <Label fx:id="lblMensaje" wrapText="true" minHeight="-Infinity"/>

            <Button fx:id="btnPagarSaldo" text="Pagar con saldo" defaultButton="true"
                    onAction="#onPagarConSaldo" styleClass="boton-principal" maxWidth="Infinity"/>
            <Button fx:id="btnPagarPuntos" text="Pagar con puntos" onAction="#onPagarConPuntos" maxWidth="Infinity"/>
            <Button fx:id="btnIrPanel" text="Volver al inicio" onAction="#onIrPanel" maxWidth="Infinity"
                    visible="false" managed="false"/>
        </VBox>
    </HBox>

    <HBox>
        <Button fx:id="btnVolver" text="Volver a los asientos" cancelButton="true" onAction="#onVolver"/>
    </HBox>
</VBox>
