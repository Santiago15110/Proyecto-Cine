<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" prefWidth="860.0" styleClass="raiz" stylesheets="@estilos.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectocine.viewController.AdminClientesViewController">
    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label text="Gestión de clientes y tarjetas" styleClass="titulo"/>
            <Label text="Consulta los clientes registrados, recarga saldo o cambia el estado de su tarjeta virtual"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="← Volver al panel" onAction="#onVolver"/>
    </HBox>

    <TableView fx:id="tblClientes" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="colCedula" text="Cédula" prefWidth="110.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="185.0"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="195.0"/>
            <TableColumn fx:id="colSaldo" text="Saldo tarjeta" prefWidth="115.0"/>
            <TableColumn fx:id="colPuntos" text="Puntos" prefWidth="80.0"/>
            <TableColumn fx:id="colEstadoTarjeta" text="Estado tarjeta" prefWidth="115.0"/>
        </columns>
        <placeholder>
            <Label text="No hay clientes registrados"/>
        </placeholder>
    </TableView>

    <VBox spacing="12.0" styleClass="tarjeta">
        <Label fx:id="lblClienteSeleccionado" text="Selecciona un cliente de la tabla" styleClass="subtitulo"/>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Monto a recargar ($):"/>
            <TextField fx:id="txtMontoRecarga" promptText="Ej: 50000" prefWidth="150.0"/>
            <Button text="Recargar saldo" onAction="#onRecargar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Bloquear tarjeta" onAction="#onBloquearTarjeta"/>
            <Button text="Activar tarjeta" onAction="#onActivarTarjeta"/>
        </HBox>

        <Label fx:id="lblMensaje" text=""/>
    </VBox>

    <VBox spacing="10.0" styleClass="tarjeta">
        <Label fx:id="lblTituloSolicitudes" text="Solicitudes de recarga pendientes" styleClass="subtitulo"/>
        <TableView fx:id="tblSolicitudes" prefHeight="140.0">
            <columns>
                <TableColumn fx:id="colSolFecha" text="Fecha" prefWidth="140.0"/>
                <TableColumn fx:id="colSolCliente" text="Cliente" prefWidth="200.0"/>
                <TableColumn fx:id="colSolCedula" text="Cédula" prefWidth="120.0"/>
                <TableColumn fx:id="colSolMonto" text="Monto" prefWidth="120.0"/>
                <TableColumn fx:id="colSolSaldo" text="Saldo actual" prefWidth="120.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay solicitudes pendientes"/>
            </placeholder>
        </TableView>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Button text="Aprobar y recargar" onAction="#onAprobarSolicitud" styleClass="boton-principal"/>
            <Button text="Rechazar" onAction="#onRechazarSolicitud"/>
        </HBox>
    </VBox>
</VBox>